extends SceneTree
## Pure fake-clock/activity regression. Never reads actual user activity or files.
const Scheduler = preload("res://scripts/proactive_scheduler.gd")
var checks := 0
var failures: Array[String] = []

func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures.append(label)

func fixture(overrides: Dictionary = {}) -> Dictionary:
	var settings := Scheduler.DEFAULTS.duplicate()
	settings.proactive = true
	settings.merge(overrides, true)
	var scheduler = Scheduler.new()
	scheduler.configure(settings)
	scheduler.random_source = func(): return 0.0
	var data := {"scheduler":scheduler, "settings":settings, "now":1800000000.0,
		"snapshot":{"now_unix":1800000000.0, "local_day":"2026-10-30", "local_hour":12,
		"idle_seconds":0.0, "locked":false, "fullscreen":false, "allowed":true, "dialog_open":false}}
	scheduler.advance(1.0, data.snapshot)
	return data

func step(data: Dictionary, seconds: int = 1, overrides: Dictionary = {}) -> Array:
	var events: Array = []
	for second in seconds:
		data.now += 1.0
		var snapshot: Dictionary = data.snapshot.duplicate()
		snapshot.merge(overrides, true); snapshot.now_unix = data.now
		var event: Dictionary = data.scheduler.advance(1.0, snapshot)
		if not event.is_empty(): events.append(event)
	return events

func game(data: Dictionary, score: int = 12) -> Array:
	data.scheduler.note_game_finished("juggle", score)
	return step(data)

func _initialize() -> void:
	var disabled := fixture({"proactive":false})
	check(step(disabled, 14400).is_empty(), "disabled scheduler never invites")
	check(disabled.scheduler.active_seconds == 0.0, "disabled scheduler does not accumulate use")
	check(game(disabled).is_empty(), "disabled game invitations stay off")
	var active := fixture()
	check(game(active).is_empty(), "startup game is suppressed during warmup")
	check(step(active, 3598).is_empty(), "no rest invitation before an active hour")
	var events := step(active)
	check(events.size() == 1 and events[0].reason == "rest", "one active hour invites a rest")
	check(events[0].context == {"continuous_minutes":60}, "rest context is minimal")
	check(game(active).is_empty(), "global cooldown also applies to games")
	check(active.scheduler.dump_state().daily_count == 1, "suppressed events do not count as displayed attempts")
	var inactive := fixture()
	check(step(inactive, 3600, {"idle_seconds":90.0}).is_empty(), "inactive reading interval does not accumulate input-active time")
	check(inactive.scheduler.active_seconds == 0.0, "coarse idle activity pauses counters")
	step(inactive, 2500)
	step(inactive, 1, {"idle_seconds":300.0})
	check(inactive.scheduler.active_seconds == 0.0, "five-minute absence counts as a break")
	check(game(inactive).is_empty(), "returning from a break gives a five-minute grace")
	step(inactive, 300)
	check(game(inactive).size() == 1, "normal reminders can resume after return grace")
	var fullscreen := fixture()
	step(fullscreen, 3599)
	check(step(fullscreen, 1, {"fullscreen":true}).is_empty(), "fullscreen suppresses due rest")
	check(step(fullscreen, 300).is_empty(), "leaving fullscreen does not replay missed rest")
	var conversation := fixture()
	step(conversation, 3599)
	check(step(conversation, 1, {"dialog_open":true}).is_empty(), "an open conversation suppresses reminders")
	check(step(conversation, 1).is_empty(), "closing conversation has no queued reminder")
	var physical := fixture()
	step(physical, 301)
	physical.scheduler.note_pet_interaction()
	physical.scheduler.note_game_finished("catch", 9)
	check(step(physical, 6, {"allowed":false}).is_empty(), "game reminder waits for brief landing animation")
	events = step(physical)
	check(events.size() == 1 and events[0].context == {"game":"catch", "score":9}, "fresh game context survives a short physical interruption")
	var stale := fixture()
	step(stale, 301); stale.scheduler.note_game_finished("juggle", 14)
	check(step(stale, 16, {"allowed":false}).is_empty(), "busy game reminder expires in fifteen seconds")
	check(step(stale).is_empty(), "expired game cannot appear later")
	stale.scheduler.random_source = func(): return 0.25
	check(game(stale).is_empty(), "game probability excludes the seventy-five percent branch")
	stale.scheduler.random_source = func(): return 0.24999
	check(game(stale).size() == 1, "game probability includes the twenty-five percent branch")
	var quiet := fixture()
	step(quiet, 3599, {"local_hour":23})
	check(step(quiet, 1, {"local_hour":23}).is_empty(), "quiet hours span midnight")
	check(step(quiet, 1, {"local_hour":8}).is_empty(), "quiet period end does not replay a reminder")
	check(game(quiet).is_empty(), "quiet-hours exit has warmup")
	step(quiet, 300)
	check(game(quiet).size() == 1, "fresh event works after quiet exit grace")
	var equal_quiet := fixture({"quiet_start":12,"quiet_end":12})
	step(equal_quiet, 301)
	check(game(equal_quiet).size() == 1, "equal quiet endpoints mean no quiet period")
	var daylight_quiet := fixture({"quiet_start":10,"quiet_end":14})
	step(daylight_quiet, 301)
	check(game(daylight_quiet).is_empty(), "non-wrapping quiet period works")
	var daily := fixture({"proactive_daily_limit":2,"proactive_interval_minutes":15})
	step(daily, 301)
	check(game(daily).size() == 1, "first daily reminder")
	step(daily, 900)
	check(game(daily).size() == 1, "second daily reminder")
	step(daily, 900)
	check(game(daily).is_empty(), "daily limit applies across reasons")
	var persisted: Dictionary = daily.scheduler.dump_state()
	var resumed := fixture(daily.settings)
	resumed.now = daily.now
	resumed.scheduler.load_state(persisted)
	step(resumed, 302)
	check(game(resumed).is_empty(), "restart preserves daily limit")
	resumed.snapshot.local_day = "2026-10-31"
	var new_day_events := step(resumed, 901)
	new_day_events.append_array(game(resumed))
	check(new_day_events.size() == 1, "new day resets the daily cap for the first eligible reconnect or game invitation")
	var unlimited := fixture({"proactive_daily_limit":0,"proactive_interval_minutes":15,"proactive_rest":false,"proactive_reconnect":false})
	check(unlimited.scheduler.options.proactive_daily_limit == 0, "zero selects unlimited daily invitations")
	step(unlimited, 301)
	var unlimited_count := 0
	for offer in range(10):
		if offer > 0: step(unlimited, 900)
		unlimited_count += game(unlimited).size()
	check(unlimited_count == 10 and unlimited.scheduler.dump_state().daily_count == 10, "unlimited mode permits more than eight eligible invitations")
	check(game(unlimited).is_empty(), "unlimited mode still respects ordinary cooldown")
	var unlimited_resumed := fixture(unlimited.settings)
	unlimited_resumed.now = unlimited.now
	unlimited_resumed.scheduler.load_state(unlimited.scheduler.dump_state())
	check(unlimited_resumed.scheduler.dump_state().daily_count == 10, "unlimited daily count survives restart without truncation")
	step(unlimited_resumed, 901)
	check(game(unlimited_resumed).size() == 1, "unlimited invitations resume after restart grace and cooldown")
	var finite_again: Dictionary = unlimited.settings.duplicate()
	finite_again.proactive_daily_limit = 8
	unlimited_resumed.scheduler.configure(finite_again)
	step(unlimited_resumed, 901)
	check(game(unlimited_resumed).is_empty(), "restoring a finite cap respects today's unlimited-mode count")
	var unlimited_gates := fixture(unlimited.settings)
	step(unlimited_gates, 301)
	unlimited_gates.scheduler.note_game_finished("juggle", 1)
	check(step(unlimited_gates, 1, {"fullscreen":true}).is_empty(), "unlimited mode still suppresses fullscreen invitations")
	unlimited_gates.scheduler.note_game_finished("juggle", 1)
	check(step(unlimited_gates, 1, {"dialog_open":true}).is_empty(), "unlimited mode still suppresses an open conversation")
	unlimited_gates.scheduler.note_game_finished("juggle", 1)
	check(step(unlimited_gates, 1, {"local_hour":23}).is_empty(), "unlimited mode still respects quiet hours")
	step(unlimited_gates, 302)
	check(game(unlimited_gates).size() == 1, "unlimited mode can invite after quiet-hours grace")
	unlimited_gates.scheduler.feedback("ignored")
	step(unlimited_gates, 900)
	check(game(unlimited_gates).size() == 1, "unlimited mode permits the second ordinarily spaced offer")
	unlimited_gates.scheduler.feedback("ignored")
	step(unlimited_gates, 900)
	check(game(unlimited_gates).is_empty(), "unlimited mode retains ignored-invitation frequency reduction")
	step(unlimited_gates, 900)
	check(game(unlimited_gates).size() == 1, "unlimited mode permits an offer after reduced-frequency cooldown")
	unlimited_gates.scheduler.feedback("quiet_today")
	step(unlimited_gates, 3600)
	check(game(unlimited_gates).is_empty(), "today-quiet also applies in unlimited mode")
	var silent := fixture()
	step(silent, 301); game(silent)
	silent.scheduler.feedback("quiet_today")
	var silenced: Dictionary = silent.scheduler.dump_state()
	var restored := fixture()
	restored.scheduler.load_state(silenced)
	step(restored, 7200)
	check(game(restored).is_empty(), "today-quiet survives restart")
	restored.snapshot.local_day = "2026-10-31"
	step(restored, 301)
	check(game(restored).size() == 1, "today-quiet does not mute tomorrow")
	var ignored := fixture({"proactive_interval_minutes":15,"proactive_daily_limit":8,"proactive_rest":false,"proactive_reconnect":false})
	step(ignored, 301); game(ignored); ignored.scheduler.feedback("ignored")
	ignored.scheduler.feedback("ignored")
	check(ignored.scheduler.dump_state().ignore_streak == 1, "feedback cannot count a dismissal twice")
	step(ignored, 900); game(ignored); ignored.scheduler.feedback("ignored")
	step(ignored, 900)
	check(game(ignored).is_empty(), "two ignored invitations double the interval")
	step(ignored, 900)
	check(game(ignored).size() == 1, "reduced frequency still allows a later invitation")
	ignored.scheduler.feedback("replied")
	check(ignored.scheduler.dump_state().ignore_streak == 0, "reply restores ordinary frequency")
	var later := fixture()
	step(later, 301); game(later, 42); later.scheduler.feedback("snooze")
	check(step(later, 599).is_empty(), "snooze waits ten minutes")
	events = step(later)
	check(events.size() == 1 and events[0].context.score == 42, "explicit snooze overrides general cooldown once")
	later.scheduler.feedback("snooze")
	step(later, 599)
	check(step(later, 1, {"fullscreen":true}).is_empty(), "snooze still respects fullscreen")
	check(step(later).is_empty(), "missed snooze does not accumulate")
	var reconnect := fixture({"proactive_rest":false})
	check(step(reconnect, 3599).is_empty(), "default reconnect waits sixty active minutes")
	events = step(reconnect)
	check(events.size() == 1 and events[0].reason == "reconnect", "reconnect uses its own trigger")
	reconnect.scheduler.note_pet_interaction()
	check(reconnect.scheduler.active_since_interaction == 0.0, "pet interaction resets reconnect time")
	var toggles := fixture({"proactive_rest":false,"proactive_reconnect":false,"proactive_games":false})
	check(step(toggles, 10800).is_empty() and game(toggles).is_empty(), "each invitation type can be disabled")
	var sleeping := fixture()
	step(sleeping, 3599)
	sleeping.now += 1200.0
	var sleep_snapshot: Dictionary = sleeping.snapshot.duplicate()
	sleep_snapshot.now_unix = sleeping.now
	check(sleeping.scheduler.advance(1.0, sleep_snapshot).is_empty(), "wall-clock gap detects suspend without dt catch-up")
	check(sleeping.scheduler.active_seconds == 0.0 and game(sleeping).is_empty(), "suspend clears activity and gives resume grace")
	step(sleeping, 301)
	step(sleeping, 1, {"locked":true})
	check(game(sleeping).is_empty(), "unlock waits instead of immediately inviting")
	step(sleeping, 301)
	sleeping.now -= 900.0
	check(step(sleeping).is_empty() and game(sleeping).is_empty(), "clock rollback cannot trigger a burst")
	var bad := fixture()
	var invalid: Dictionary = bad.snapshot.duplicate()
	invalid.idle_seconds = NAN
	check(bad.scheduler.advance(1.0, invalid).is_empty(), "invalid native activity fails closed")
	bad.scheduler.configure({"proactive":true,"proactive_interval_minutes":-100,"proactive_daily_limit":999,"quiet_start":-1,"quiet_end":99})
	check(bad.scheduler.options.proactive_interval_minutes == 5 and bad.scheduler.options.proactive_daily_limit == 8 and bad.scheduler.options.quiet_start == 0 and bad.scheduler.options.quiet_end == 23, "settings are bounded")
	bad.scheduler.load_state({"schema":1,"day":"2026-10-30","daily_count":-1,"ignore_streak":INF,"last_offer":NAN,
		"snooze":{"reason":"game","at":1800000600.0,"context":{"game":"catch","score":9,"secret":"do-not-keep"}}})
	var sanitized: Dictionary = bad.scheduler.dump_state()
	check(sanitized.daily_count == 0 and sanitized.ignore_streak == 0 and sanitized.last_offer == 0.0, "invalid persisted numbers are sanitized")
	check(not str(sanitized).contains("do-not-keep"), "persisted reminder context is whitelisted")
	check(bad.scheduler.active_seconds == 0.0, "continuous activity is never restored after restart")
	var load_first := Scheduler.new()
	load_first.load_state(sanitized)
	load_first.configure({"proactive":true})
	check(load_first.dump_state().snooze == sanitized.snooze, "first configuration preserves a loaded snooze regardless of setup order")
	load_first.configure({"proactive":false}); load_first.configure({"proactive":true})
	check(load_first.dump_state().snooze.is_empty(), "explicit disable and reenable clear an old snooze")
	var unavailable := fixture()
	step(unavailable, 301); game(unavailable); unavailable.scheduler.feedback("unavailable")
	check(unavailable.scheduler.dump_state().ignore_streak == 0, "API failure is not treated as user rejection")
	var reset := fixture()
	step(reset, 3500)
	reset.scheduler.configure({"proactive":false}); reset.scheduler.configure({"proactive":true})
	check(step(reset, 300).is_empty() and reset.scheduler.active_seconds < 300.0, "reenabling starts fresh rather than firing stale thresholds")
	verify_frequency_levels()
	verify_quiet_switch()
	for failure in failures: printerr("PROACTIVE SCHEDULER: " + failure)
	print(JSON.stringify({"checks":checks,"failures":failures,"offline":true}))
	quit(0 if failures.is_empty() else 1)

func verify_frequency_levels() -> void:
	for minutes in [120,60,30,15,5]:
		var level := fixture({"proactive_interval_minutes":minutes,"proactive_daily_limit":0,
			"proactive_rest":false,"proactive_games":false,"quiet_enabled":false})
		check(level.scheduler.options.proactive_interval_minutes == minutes, "frequency level retains %d minutes" % minutes)
		check(step(level, minutes * 60 - 1).is_empty(), "%d-minute level waits its actual active-time trigger" % minutes)
		var offered := step(level)
		check(offered.size() == 1 and offered[0].reason == "reconnect", "%d-minute level produces a reconnect at its own cadence" % minutes)
	var fast := fixture({"proactive_interval_minutes":5,"proactive_daily_limit":0,"proactive_rest":false,"proactive_games":false,"quiet_enabled":false})
	var slow := fixture({"proactive_interval_minutes":120,"proactive_daily_limit":0,"proactive_rest":false,"proactive_games":false,"quiet_enabled":false})
	var fast_events := step(fast, 7200)
	var slow_events := step(slow, 7200)
	check(fast_events.size() == 24 and slow_events.size() == 1, "five-minute mode creates more actual invitations than two-hour mode over equal active use")
	var changed := fixture({"proactive_interval_minutes":120,"proactive_daily_limit":0,"proactive_rest":false,"proactive_games":false,"quiet_enabled":false})
	step(changed, 6600)
	var new_settings: Dictionary = changed.settings.duplicate()
	new_settings.proactive_interval_minutes = 5
	changed.scheduler.configure(new_settings)
	check(step(changed, 299).is_empty(), "switching to a faster cadence does not immediately spend old accumulated activity")
	check(step(changed).size() == 1, "faster cadence starts a complete new interval from the change")
	check(step(changed, 299).is_empty() and step(changed).size() == 1, "rebased cadence keeps equally spaced invitations after its first offer")
	changed.scheduler.note_pet_interaction()
	check(step(changed, 299).is_empty() and step(changed).size() == 1, "interaction resets reconnect using the selected five-minute cadence")
	var next_deadline: float = changed.scheduler._next_reconnect_at
	new_settings.proactive_daily_limit = 8
	changed.scheduler.configure(new_settings)
	check(changed.scheduler._next_reconnect_at == next_deadline, "unrelated configuration does not restart reconnect timing")
	var reduced := fixture({"proactive_interval_minutes":5,"proactive_daily_limit":0,"proactive_rest":false,"proactive_games":false,"quiet_enabled":false})
	step(reduced, 240)
	new_settings = reduced.settings.duplicate(); new_settings.proactive_interval_minutes = 120
	reduced.scheduler.configure(new_settings)
	check(step(reduced, 7199).is_empty() and step(reduced).size() == 1, "slower frequency replaces the previous impending five-minute deadline")
	var suppressed := fixture({"proactive_interval_minutes":5,"proactive_daily_limit":0,"proactive_rest":false,"proactive_games":false,"quiet_enabled":false})
	check(step(suppressed, 600, {"dialog_open":true}).is_empty(), "frequent unlimited reconnect still respects an open conversation")
	check(step(suppressed, 299).is_empty() and step(suppressed).size() == 1, "closing conversation does not replay suppressed reconnect deadlines")
	check(step(suppressed, 300, {"fullscreen":true}).is_empty(), "frequent unlimited reconnect still respects fullscreen")
	check(step(suppressed, 300, {"allowed":false}).is_empty(), "frequent unlimited reconnect still respects gameplay and host busy state")
	check(step(suppressed, 299).is_empty() and step(suppressed).size() == 1, "ending gameplay waits for the next scheduled invitation without backlog")
	var preserved_rest := fixture({"proactive_interval_minutes":5,"proactive_daily_limit":0,"proactive_reconnect":false,"proactive_games":false,"quiet_enabled":false})
	check(step(preserved_rest, 3599).is_empty() and step(preserved_rest).size() == 1, "five-minute chat frequency leaves the one-hour rest reminder unchanged")

func verify_quiet_switch() -> void:
	var legacy := Scheduler.new()
	legacy.configure({"quiet_start":7,"quiet_end":7})
	check(not legacy.options.quiet_enabled, "legacy equal quiet endpoints migrate to disabled quiet mode")
	legacy.configure({"quiet_start":22,"quiet_end":8})
	check(legacy.options.quiet_enabled and legacy._quiet(23), "legacy non-equal quiet endpoints remain enabled")
	legacy.configure({"quiet_enabled":false,"quiet_start":22,"quiet_end":8})
	check(not legacy._quiet(23) and legacy.options.quiet_start == 22 and legacy.options.quiet_end == 8, "disabling quiet hours retains the configured clock times")
	var quiet_off := fixture({"quiet_enabled":false,"proactive_interval_minutes":5,"proactive_daily_limit":0,"proactive_rest":false,"proactive_reconnect":false})
	quiet_off.snapshot.local_hour = 23
	step(quiet_off, 301)
	check(game(quiet_off).size() == 1, "quiet-off permits a normal eligible invitation at night")
	var changed: Dictionary = quiet_off.settings.duplicate()
	changed.quiet_enabled = true
	quiet_off.scheduler.configure(changed)
	step(quiet_off, 301)
	check(game(quiet_off).is_empty(), "re-enabling quiet hours immediately respects the retained night range")
	changed.quiet_enabled = false
	quiet_off.scheduler.configure(changed)
	check(game(quiet_off).is_empty(), "disabling an active quiet period preserves return grace rather than releasing a burst")
	step(quiet_off, 301)
	check(game(quiet_off).size() == 1, "quiet-off resumes after ordinary return grace")
	quiet_off.scheduler.feedback("quiet_today")
	step(quiet_off, 600)
	check(game(quiet_off).is_empty(), "quiet-off never cancels an explicit today-quiet request")
	var restored := fixture(quiet_off.settings)
	restored.now = quiet_off.now
	restored.snapshot.local_hour = 23
	restored.scheduler.load_state(quiet_off.scheduler.dump_state())
	step(restored, 301)
	check(game(restored).is_empty(), "today-quiet still survives restart while scheduled quiet hours are disabled")
