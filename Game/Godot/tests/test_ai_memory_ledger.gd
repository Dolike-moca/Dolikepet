extends SceneTree
## Pure fake-time regression: no files, live credentials or network access.
const Ledger = preload("res://scripts/ai_memory_ledger.gd")
const DAY := 86400
var checks := 0
var failures: Array[String] = []
var start := int(Time.get_unix_time_from_datetime_string("2026-11-01T12:00:00"))

func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures.append(label)

func day(at: int) -> String:
	return Time.get_date_string_from_unix_time(at)

func make_item(source: Dictionary, changes: Dictionary = {}) -> Dictionary:
	var result := {"op":"remember", "text":"用户喜欢吃薯条", "kind":"preference", "subject":"food.fries",
		"source_ids":[source.id], "quote":source.text, "target_id":""}
	result.merge(changes, true)
	return result

func submit(ledger: RefCounted, at: int, text: String = "我喜欢吃薯条", changes: Dictionary = {}) -> bool:
	ledger.enqueue(text, at, day(at))
	var batch: Array = ledger.batch()
	if batch.is_empty(): return false
	return ledger.apply_result({"items":[make_item(batch.back(), changes)]}, batch, at, day(at))

func _initialize() -> void:
	var migration = Ledger.new()
	migration.load_state(null, ["请称呼我为小铃", "我喜欢薯条", "我喜欢薯条", 23], start)
	check(migration.texts() == ["请称呼我为小铃", "我喜欢薯条"], "legacy strings migrate without duplicates or invented content")
	check(migration.list_entries()[0].tier == "fixed", "legacy memories are fixed")
	check(not migration.advance(start + 500 * DAY) and migration.texts().size() == 2, "fixed memories never age out")
	check(not migration.add_fixed("我喜欢薯条", start), "duplicate manual memory rejected")
	check(not migration.add_fixed(" ", start) and not migration.add_fixed("字".repeat(301), start), "manual memory validates length")
	var id: String = migration.list_entries()[0].id
	check(migration.edit(id, "请称呼我为小可", start + DAY), "manual editing succeeds")
	check(migration.list_entries()[0].sources[0].quote == "请称呼我为小可", "editing replaces obsolete source evidence")
	check(migration.pin(id, start + DAY), "pinning an already fixed entry is idempotent")
	check(not migration.edit("missing", "你好", start) and not migration.forget("missing", start), "stale UI identifiers never target another entry")
	var stable = Ledger.new()
	check(submit(stable, start), "first fact accepted")
	check(stable.list_entries().size() == 1 and stable.list_entries()[0].tier == "recent", "first user fact starts recent")
	check(stable.batch().is_empty(), "successful extraction consumes user sources")
	check(submit(stable, start + 60) and stable.list_entries()[0].days.size() == 1, "same-day repetitions do not multiply evidence days")
	check(submit(stable, start + DAY) and stable.list_entries()[0].tier == "recent", "two days are not yet long-term")
	check(submit(stable, start + 2 * DAY) and stable.list_entries()[0].tier == "long", "three independent user days promote stable fact")
	check(stable.list_entries()[0].sources.size() == 3 and stable.list_entries()[0].days.size() == 3, "bounded source references and day count retained")
	var reversed = Ledger.new()
	for offset in 3: reversed.enqueue("我喜欢吃薯条", start + offset * DAY, day(start + offset * DAY))
	var reversed_sources: Array = reversed.batch()
	var reversed_items: Array = []
	for index in range(reversed_sources.size() - 1, -1, -1): reversed_items.append(make_item(reversed_sources[index]))
	check(reversed.apply_result({"items":reversed_items}, reversed_sources, start + 2 * DAY, day(start + 2 * DAY)), "reverse chronological batch is accepted")
	check(reversed.list_entries()[0].tier == "long" and reversed.list_entries()[0].days.size() == 3, "all independent user days reinforce regardless of model item ordering")
	check(reversed.list_entries()[0].last_seen == start + 2 * DAY, "reverse chronological reinforcement preserves newest source time")
	check(not reversed.apply_result({"items":reversed_items}, reversed_sources, start + 3 * DAY, day(start + 3 * DAY)), "processed reverse-order sources cannot be replayed")
	check(stable.advance(start + 182 * DAY) and stable.list_entries()[0].tier == "recent" and stable.list_entries()[0].faded, "long memory demotes after 180 days from last mention")
	check(not stable.advance(start + 211 * DAY) and stable.list_entries().size() == 1, "demoted long memory has thirty-day grace")
	check(stable.advance(start + 212 * DAY) and stable.list_entries().is_empty(), "demoted long memory expires after grace")
	check(submit(stable, start + 213 * DAY), "naturally expired facts may be learned again")
	var scattered = Ledger.new()
	submit(scattered, start)
	submit(scattered, start + 31 * DAY)
	submit(scattered, start + 32 * DAY)
	check(scattered.list_entries()[0].tier == "recent" and scattered.list_entries()[0].days.size() == 2, "evidence outside thirty-day window cannot promote")
	var ageing = Ledger.new()
	submit(ageing, start)
	check(ageing.advance(start + 30 * DAY) and ageing.list_entries()[0].faded, "recent fact fades at thirty days")
	var ageing_snapshot: Dictionary = ageing.dump_state()
	var restored = Ledger.new()
	restored.load_state(ageing_snapshot, [], start + 70 * DAY)
	check(restored.dump_state() == ageing_snapshot, "loading is rollback-safe and does not run expiry")
	check(restored.recall_entries(start + 70 * DAY).is_empty(), "unsaved expired entries are still excluded from model recall")
	check(ageing.advance(start + 60 * DAY) and ageing.list_entries().is_empty(), "ordinary fact expires at sixty days")
	var transient = Ledger.new()
	submit(transient, start, "今天有点累", {"text":"用户今天有些疲惫", "kind":"state", "subject":"state.tired", "expires_at":start + DAY})
	check(transient.list_entries()[0].expires_at == start + DAY, "state may retain one day")
	check(transient.advance(start + DAY) and transient.list_entries().is_empty(), "temporary emotion expires rather than become personality")
	submit(transient, start + DAY, "今天有点累", {"text":"用户今天有些疲惫", "kind":"state", "subject":"state.tired", "expires_at":start + 1000 * DAY})
	check(transient.list_entries()[0].expires_at == start + 4 * DAY, "model cannot make temporary state persist beyond three days")
	var event = Ledger.new()
	submit(event, start, "这周五考试", {"text":"用户这周五有考试", "kind":"event", "subject":"event.exam", "expires_at":start + 4 * DAY})
	check(event.advance(start + 4 * DAY) and event.list_entries().is_empty(), "event expires at supplied ending")
	var stale = Ledger.new()
	stale.enqueue("今天有点累", start, day(start))
	var old_sources: Array = stale.batch()
	stale.apply_result({"items":[make_item(old_sources[0], {"text":"用户今天有点累", "subject":"state.tired", "kind":"state"})]}, old_sources, start + 10 * DAY, day(start + 10 * DAY))
	check(stale.list_entries().is_empty(), "delayed processing does not rejuvenate an expired temporary state")
	var delayed = Ledger.new()
	delayed.enqueue("我喜欢薯条", start, day(start))
	var delayed_sources: Array = delayed.batch()
	delayed.apply_result({"items":[make_item(delayed_sources[0])]}, delayed_sources, start + 2 * DAY, day(start + 2 * DAY))
	var delayed_reload = Ledger.new()
	delayed_reload.load_state(delayed.dump_state(), [], start + 2 * DAY)
	check(delayed_reload.list_entries()[0].last_seen == start and delayed_reload.list_entries()[0].expires_at == start + 60 * DAY, "delayed extraction retains source-time age after reload")
	var quota = Ledger.new()
	for n in 4:
		submit(quota, start + n, "我喜欢食物%d" % n, {"text":"用户喜欢食物%d" % n, "subject":"food.%d" % n})
	check(quota.list_entries().size() == 3 and quota.dump_state().daily_new == 3, "daily automatic new-memory budget is three")
	submit(quota, start + 10, "我喜欢食物0", {"text":"用户喜欢食物0", "subject":"food.0"})
	check(quota.list_entries()[0].last_seen == start + 10 and quota.dump_state().daily_new == 3, "reinforcement does not consume new-memory budget")
	submit(quota, start - DAY, "我喜欢食物8", {"text":"用户喜欢食物8", "subject":"food.8"})
	check(quota.list_entries().size() == 3, "backwards local date cannot reset daily budget")
	submit(quota, start + DAY, "我喜欢食物9", {"text":"用户喜欢食物9", "subject":"food.9"})
	check(quota.list_entries().size() == 4 and quota.dump_state().daily_new == 1, "next day receives a fresh budget")
	var guarded = Ledger.new()
	submit(guarded, start)
	var forgotten_id: String = guarded.list_entries()[0].id
	guarded.enqueue("我喜欢吃薯条", start + 1, day(start))
	var pending: Array = guarded.batch()
	check(guarded.forget(forgotten_id, start + 2), "explicit forgetting removes entry")
	guarded.apply_result({"items":[make_item(pending.back())]}, pending, start + 3, day(start))
	check(guarded.list_entries().is_empty(), "old queued paraphrase cannot restore forgotten fact")
	check(submit(guarded, start + DAY) and guarded.list_entries().is_empty(), "ordinary fresh repetition respects intentional forgetting")
	var forgotten_state: Dictionary = guarded.dump_state()
	var reloaded = Ledger.new()
	reloaded.load_state(forgotten_state, [], start + 2 * DAY)
	submit(reloaded, start + 2 * DAY)
	check(reloaded.list_entries().is_empty(), "forget guard survives restart")
	check(reloaded.add_fixed("用户喜欢吃薯条", start + 2 * DAY), "manual explicit memory can override automatic forget guard")
	check(reloaded.forget_text("薯条", start + 2 * DAY) == 1, "forget command finds related content")
	submit(reloaded, start + 3 * DAY, "我喜欢薯条", {"text":"用户偏爱刚炸好的薯条", "subject":"preference.snack"})
	check(reloaded.list_entries().is_empty(), "forget query fragment prevents changed subject or wording from resurrecting fact")
	check(reloaded.forget_text("咖啡", start) == 0, "forget unknown topic still records a guard")
	submit(reloaded, start + 4 * DAY, "我喜欢咖啡", {"text":"用户喜欢咖啡", "subject":"drink.preference"})
	check(reloaded.list_entries().is_empty(), "unknown-topic forget also blocks later automatic extraction")
	var pronouns = Ledger.new()
	submit(pronouns, start, "我喜欢薯条", {"text":"用户喜欢薯条"})
	submit(pronouns, start, "我喜欢咖啡", {"text":"用户喜欢咖啡", "subject":"drink.coffee"})
	check(pronouns.forget_text("我喜欢薯条。", start + 1) == 1, "first-person forget command matches third-person automatic memory")
	check(pronouns.texts() == ["用户喜欢咖啡"], "pronoun normalization leaves unrelated facts untouched")
	check(pronouns.forget_text("关于我喜欢咖啡的事", start + 2) == 1, "explicit topic wrapper and suffix normalize conservatively")
	check(pronouns.list_entries().is_empty(), "wrapped forget removes only its matching topic")
	var unspecified = Ledger.new()
	unspecified.add_fixed("用户喜欢薯条", start)
	check(unspecified.forget_text("我喜欢这件事", start + 1) == 0 and unspecified.texts().size() == 1, "unspecified pronoun does not expand into deletion of all likes")
	var corrected = Ledger.new()
	submit(corrected, start)
	var corrected_id: String = corrected.list_entries()[0].id
	submit(corrected, start + 60, "我现在不喜欢薯条了", {"text":"用户现在不喜欢薯条"})
	check(corrected.texts() == ["用户喜欢吃薯条"] and corrected.list_entries()[0].last_seen == start, "remember operation cannot reinforce a contrary old fact")
	submit(corrected, start + DAY, "我现在不喜欢薯条了", {"op":"correct", "target_id":corrected_id, "text":"用户现在不喜欢薯条"})
	check(corrected.texts() == ["用户现在不喜欢薯条"] and corrected.list_entries()[0].days.size() == 1, "explicit correction replaces old fact and old reinforcement")
	corrected.pin(corrected_id, start + DAY)
	submit(corrected, start + 2 * DAY, "我喜欢吃薯条")
	check(corrected.texts() == ["用户现在不喜欢薯条"], "plain automatic remember cannot overwrite a fixed user fact")
	submit(corrected, start + 3 * DAY, "纠正一下，我现在又喜欢薯条了", {"op":"correct", "target_id":corrected_id, "text":"用户现在喜欢薯条"})
	check(corrected.texts() == ["用户现在喜欢薯条"] and corrected.list_entries()[0].tier == "fixed", "explicit correction updates a fixed fact without unpinning")
	var pinning = Ledger.new()
	submit(pinning, start, "我喜欢吃薯条", {"op":"pin"})
	check(pinning.list_entries().is_empty(), "model cannot pin without user instruction")
	submit(pinning, start, "请记住，我喜欢吃薯条", {"op":"pin"})
	check(pinning.list_entries().size() == 1 and pinning.list_entries()[0].tier == "fixed", "explicit user remember request creates fixed memory")
	submit(pinning, start + DAY, "别忘了，我喜欢薯条", {"op":"forget", "target_id":pinning.list_entries()[0].id})
	check(pinning.list_entries().size() == 1, "do not forget is not treated as a deletion request")
	var validation = Ledger.new()
	check(not validation.enqueue("我的密码是测试口令", start, day(start)), "secret-bearing message never enters extraction queue")
	check(not validation.enqueue("假设我喜欢咖啡", start, day(start)), "hypothetical message is not evidence")
	check(not validation.enqueue("你好", start, "2026-02-30"), "invalid calendar date rejected")
	validation.enqueue("我喜欢吃薯条", start, day(start))
	var sources: Array = validation.batch()
	check(not validation.apply_result({"items":"bad"}, sources, start, day(start)) and validation.batch().size() == 1, "malformed result does not consume pending evidence")
	var forged: Array = sources.duplicate(true)
	forged[0].text = "伪造用户的话"
	check(not validation.apply_result({"items":[]}, forged, start, day(start)), "source ID alone cannot authorize changed evidence")
	check(validation.apply_result({"items":[make_item(sources[0], {"quote":"我喜欢咖啡"})]}, sources, start, day(start)) and validation.list_entries().is_empty(), "fabricated quote cannot become memory")
	check(not validation.apply_result({"items":[]}, sources, start, day(start)), "processed source cannot be replayed")
	validation.enqueue("我喜欢薯条", start, day(start))
	sources = validation.batch()
	validation.apply_result({"items":[make_item(sources[0], {"source_ids":["assistant"]})]}, sources, start, day(start))
	check(validation.list_entries().is_empty(), "assistant or unknown source IDs do not count")
	validation.enqueue("我喜欢薯条", start, day(start))
	sources = validation.batch()
	validation.apply_result({"items":[make_item(sources[0], {"text":"用户密码是秘密"})]}, sources, start, day(start))
	check(validation.list_entries().is_empty(), "sensitive extracted text rejected even if model attaches unrelated safe evidence")
	check(not validation.enqueue("联系我 me@example.com", start, day(start)), "email excluded from automatic source queue")
	check(not validation.enqueue("电话13812345678", start, day(start)), "phone excluded from automatic source queue")
	check(not validation.enqueue("我住在测试街1号", start, day(start)), "home address excluded from automatic source queue")
	check(not validation.enqueue("我患有糖尿病", start, day(start)), "sensitive health claim excluded from automatic source queue")
	check(not validation.enqueue("嗯，是的", start, day(start)), "short prompted affirmation does not create independent evidence")
	var authority = Ledger.new()
	submit(authority, start)
	var authority_id: String = authority.list_entries()[0].id
	authority.enqueue("我现在不喜欢薯条了", start + 1, day(start))
	var before_edit: Array = authority.batch()
	check(authority.edit(authority_id, "用户还是喜欢薯条", start + 10), "manual edit establishes revision boundary")
	authority.apply_result({"items":[make_item(before_edit[0], {"op":"correct", "target_id":authority_id, "text":"用户不喜欢薯条"})]}, before_edit, start + DAY, day(start + DAY))
	check(authority.texts() == ["用户还是喜欢薯条"], "queued old correction cannot overwrite newer manual edit")
	var authority_loaded = Ledger.new()
	authority.enqueue("我现在不喜欢薯条了", start + DAY, day(start + DAY))
	before_edit = authority.batch()
	authority.pin(authority_id, start + DAY)
	authority_loaded.load_state(authority.dump_state(), [], start + DAY)
	authority_loaded.apply_result({"items":[make_item(before_edit[0], {"op":"correct", "target_id":authority_id, "text":"用户不喜欢薯条"})]}, before_edit, start + 2 * DAY, day(start + 2 * DAY))
	check(authority_loaded.texts() == ["用户还是喜欢薯条"], "manual pin serial boundary survives restart and same-second source")
	var negated = Ledger.new()
	submit(negated, start)
	var negated_id: String = negated.list_entries()[0].id
	submit(negated, start + DAY, "别忘记我喜欢薯条", {"op":"forget", "target_id":negated_id})
	check(negated.list_entries().size() == 1, "negative forget instruction cannot erase a memory")
	submit(negated, start + DAY, "忘掉我喜欢咖啡这件事", {"op":"forget", "target_id":negated_id})
	check(negated.list_entries().size() == 1, "model cannot erase unrelated arbitrary target ID")
	submit(negated, start + DAY, "记住我喜欢咖啡", {"op":"pin", "target_id":negated_id, "text":"用户喜欢咖啡", "subject":"drink.coffee"})
	check(negated.list_entries()[0].tier == "recent", "model cannot pin unrelated arbitrary target ID")
	var per_item = Ledger.new()
	submit(per_item, start)
	per_item.enqueue("忘掉我喜欢薯条，我喜欢咖啡", start + 1, day(start))
	var per_item_sources: Array = per_item.batch()
	per_item.apply_result({"items":[make_item(per_item_sources[0], {"op":"forget", "target_id":per_item.list_entries()[0].id}), make_item(per_item_sources[0], {"text":"用户喜欢咖啡", "subject":"drink.coffee"})]}, per_item_sources, start + 2, day(start))
	check(per_item.list_entries().is_empty(), "forget invalidates pending evidence for later items in same result")
	var queued_expiry = Ledger.new()
	queued_expiry.enqueue("我喜欢薯条", start, day(start))
	check(queued_expiry.advance(start + 7 * DAY) and queued_expiry.batch().is_empty(), "unprocessed snippets expire after seven days")
	var capacity = Ledger.new()
	for n in 24: capacity.add_fixed("手动固定%d" % n, start)
	check(not capacity.add_fixed("第25条固定", start), "fixed memory capacity is explicit")
	check(capacity.recall_entries(start).size() == 24, "all legacy fixed memories remain eligible for recall")
	for n in 51:
		submit(capacity, start + int(n / 3.0) * DAY, "我喜欢食物%d" % n, {"text":"用户喜欢食物%d" % n, "subject":"food.%d" % n})
	check(capacity.list_entries().size() == 72, "automatic memory has a bounded separate capacity")
	check(capacity.list_entries()[0].tier == "fixed" and capacity.list_entries()[0].text == "手动固定0", "automatic eviction never removes manual memory")
	check(capacity.recall_entries(start + 17 * DAY).size() == 36, "automatic prompt recall capped at twelve without dropping fixed memories")
	var pending_limit = Ledger.new()
	for n in 40: pending_limit.enqueue("新消息%d" % n, start, day(start))
	check(pending_limit.dump_state().pending.size() == 32 and pending_limit.batch().size() == 12, "pending source storage and extraction batch are bounded")
	pending_limit.clear_pending()
	check(pending_limit.batch().is_empty(), "disabling automatic memory can discard unprocessed messages")
	var full_guard = Ledger.new()
	for n in 520: full_guard.forget_text("主题%04d" % n, start)
	check(full_guard.dump_state().forgotten.size() == 512 and full_guard.dump_state().forget_guard_full, "forget guard bounds storage and fails closed rather than forgetting exclusions")
	submit(full_guard, start)
	check(full_guard.list_entries().is_empty(), "full forget guard never silently drops old exclusions")
	check(full_guard.add_fixed("手动仍然有效", start), "full automatic guard does not prevent explicit manual memory")
	print("AI memory ledger: %d checks, %d failures" % [checks, failures.size()])
	for failure in failures: push_error("FAIL: " + failure)
	quit(0 if failures.is_empty() else 1)
